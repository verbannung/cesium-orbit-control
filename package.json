{
  "name": "cesium-orbit-control",
  "version": "0.1.0",
  "description": "Orbit / transform gizmo controller for Cesium",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config example/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@cesium/engine": "^24.0.0"
  },
  "devDependencies": {
    "@cesium/engine": "24.0.0",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
