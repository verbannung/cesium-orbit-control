{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "cesium-orbit-control": ["src/index.ts"]
    },
    "types": ["vitest/globals", "node"]
  },
  "include": ["src_copy", "tests", "example", "vite.config.ts", "vitest.config.ts", "example/vite.config.ts", "src/controller", "src/core", "src/event", "src/frame", "src/geometry", "src/input", "src/math", "src/overlay", "src/pick", "src/centerController.ts", "src/glsl.d.ts", "src/index.ts"],
  "exclude": ["dist", "node_modules"]
}
